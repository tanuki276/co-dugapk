  function garageCost(g) {
    return Math.floor(g.base * Math.pow(1.85, garage[g.k]));
  }
  function applyGarage() {
    maxHp = hp = 3 + garage.x;
    heatCoolRate += garage.cool * 0.07;
    heatGain = Math.max(B.minHeatGain, heatGain - garage.cool * 0.025);
    pointMagnet = Math.max(pointMagnet, garage.mag);
    oreMultiplier *= 1 + garage.ore * 0.08;
  }
  function renderGarage() {
    garageBank.textContent = `BANK ${Math.floor(totalPoints).toLocaleString()} pt`;
    garageList.innerHTML = "";
    garageDefs.forEach((g) => {
      const lv = garage[g.k],
        maxed = lv >= g.max,
        cost = garageCost(g),
        b = document.createElement("button");
      b.className = "choice";
      b.style.width = "100%";
      b.innerHTML = `<div class="icon">${g.icon}</div><h3>${g.name} LV.${lv}/${g.max}</h3><p>${g.desc}</p><em>${maxed ? "MAX" : cost.toLocaleString() + " pt"}</em>`;
      b.disabled = maxed;
      b.style.opacity = maxed ? ".55" : "1";
      b.onclick = () => {
        if (maxed) return;
        if (totalPoints < cost) {
          showToast("BANKが足りない");
          return;
        }
        bank(-cost);
        garage[g.k]++;
        saveGarage();
        renderGarage();
        showToast(`${g.name} LV.${garage[g.k]}`);
      };
      garageList.appendChild(b);
    });
  }
  function openGarage() {
    renderGarage();
    garageOverlay.classList.remove("hidden");
    paused = true;
  }
  function closeGarage() {
    garageOverlay.classList.add("hidden");
    if (started && !gameover && upgradeOverlay.classList.contains("hidden"))
      paused = false;
  }
